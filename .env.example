# Database - Supabase (transaction pooler, pgbouncer-compatible for Prisma)
# Replace <project-ref> and <password> with your Supabase credentials.
# Get it from: Supabase Dashboard > Project > Connect > Transaction pooler > URI
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Local development (optional override - .env.local takes precedence over .env)
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_business_builder?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_ID=""
GITHUB_SECRET=""

# AI Providers
# Active provider: FLEET_AI_PROVIDER=<id>. Otherwise the first provider whose
# <ID>_API_KEY is set wins (openai → openrouter → groq → xai → google →
# anthropic → mistral → deepseek → together → cerebras). Model override:
# <ID>_MODEL (e.g. OPENROUTER_MODEL, GEMINI_MODEL).
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
XAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
TOGETHER_API_KEY=""
CEREBRAS_API_KEY=""

# Email (optional)
EMAIL_SERVER=""
EMAIL_FROM=""

# Deployment (real Vercel provisioning for staging + production — "Deploy" stage)
VERCEL_TOKEN=""
# Optional: FLEET_VERCEL_OWNER="" (username or team id; defaults to the token user), FLEET_VERCEL_PROJECT_PREFIX="fleet-app"

# Monitoring (health checks probe READY deploy URLs for real; APP_URL is the
# public origin used to check relative preview URLs — defaults to localhost:3000)
APP_URL="http://localhost:3000"

# Usage/analytics (optional). Server-side product events (sign-ins, pipeline
# stage runs, deploy actions) are sent to PostHog when POSTHOG_API_KEY is set.
# Without it the tracking is an honest no-op — the /usage dashboard is always
# powered by first-party database rows and needs no analytics vendor.
# POSTHOG_API_KEY=""
# POSTHOG_HOST="https://us.i.posthog.com"

# GitHub publish (enables "Publish to GitHub" — real pushes via the Git Data API)
# GITHUB_TOKEN=""
# Optional: FLEET_GITHUB_OWNER="" (defaults to the token user), FLEET_GITHUB_REPO_PREFIX="fleet-app", FLEET_GITHUB_PRIVATE="true"

# Local sandbox: `local` lets the worker run REAL npm install / tsc / vitest
# inside each project workspace (needs node + npm + network). `none` (default)
# keeps the honest SANDBOX_UNAVAILABLE failure for installs.
# FLEET_SANDBOX=none