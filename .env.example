# Database - Supabase (transaction pooler, pgbouncer-compatible for Prisma)
# Replace <project-ref> and <password> with your Supabase credentials.
# Get it from: Supabase Dashboard > Project > Connect > Transaction pooler > URI
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Local development (optional override - .env.local takes precedence over .env)
# DATABASE_URL="postgresql://user:password@localhost:5432/ai_business_builder?schema=public"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_ID=""
GITHUB_SECRET=""

# AI Providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Email (optional)
EMAIL_SERVER=""
EMAIL_FROM=""

# Deployment
VERCEL_TOKEN=""